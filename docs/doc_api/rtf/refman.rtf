KAT_Cipher and KAT_AEAD types conduct tests in encrypt and decrypt cipher directions. However, the corrupt callback is made only for the encrypt direction. No callback is made for the decrypt direction at the moment.\par
Example detection of library self-test completion & error in the application: {
\par
\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid IMB_ARCH arch;\par
IMB_MGR *p_mgr = alloc_mb_mgr(0);\par
\par
init_mb_mgr_auto(p_mgr, &arch); /* or init_mb_mgr_sse/avx/avx2/avx512 */\par
\par
/*\par
 * check for self-test presence and successful\par
 * - requires library version v1.3 or newer\par
 */\par
if (p_mgr->features & IMB_FEATURE_SELF_TEST) \{\par
        /* self-test feature present */\par
        if (p_mgr->features & IMB_FEATURE_SELF_TEST_PASS) \{\par
                printf("SELF-TEST: PASS\\n");\par
        \} else \{\par
                printf("SELF-TEST: FAIL\\n");\par
        \}\par
\} else \{\par
        printf("SELF-TEST: N/A (requires library >= v1.3)\\n");\par
\}\par
\par
/* check for initialization self-test error */\par
if (imb_get_errno(p_mgr) == IMB_ERR_SELFTEST) \{\par
        /* self-test error */\par
        exit(EXIT_FAILURE);\par
\}\par
}
\par
Example registration of self-test callback function: {
\par
\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid int self_test_corrupt = 0;\par
\par
int callback(void *arg, const IMB_SELF_TEST_CALLBACK_DATA *data)\par
\{\par
        const char *phase = "";\par
        const char *type = "";\par
        const char *descr = "";\par
\par
        (void) arg;\par
\par
        if (data != NULL) \{\par
                if (data->phase != NULL)\par
                        phase = data->phase;\par
                if (data->type != NULL)\par
                        type = data->type;\par
                if (data->descr != NULL)\par
                        descr = data->descr;\par
        \}\par
\par
        if (strcmp(phase, IMB_SELF_TEST_PHASE_START) == 0)\par
                printf("%s : %s : ", type, descr);\par
\par
        if ((strcmp(phase, IMB_SELF_TEST_PHASE_CORRUPT) == 0) && (self_test_corrupt == 1))\par
                return 0; /* corrupt input message */\par
\par
        if (strcmp(phase, IMB_SELF_TEST_PHASE_PASS) == 0 ||\par
            strcmp(phase, IMB_SELF_TEST_PHASE_FAIL) == 0)\par
                printf("%s\\n", phase);\par
\par
        return 1;\par
\}\par
