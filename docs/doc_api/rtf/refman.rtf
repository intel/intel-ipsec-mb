{\b IMB_DLL_EXPORT} int {\b imb_ml_dsa_verify} ({\b IMB_ML_DSA} *self, const void *msg, size_t msg_len, const void *sig, size_t sig_len, const {\b IMB_ML_DSA_VERIFY_PARAMS} *params)\par
{
\pard\plain \s61\li360\sa60\sb30\qj\widctlpar\qj\adjustright \fs20\cgrid {\i {\s17\sa60\sb30\widctlpar\qj \fs22\cgrid 
Verify a signature over a message. Requires a public key to have been bound to {\i self}  via {\b imb_ml_dsa_keypair()}, {\b imb_ml_dsa_set_privkey()} (private keys carry the public component too) or {\b imb_ml_dsa_set_pubkey()}. }{
}\par
}\par}
